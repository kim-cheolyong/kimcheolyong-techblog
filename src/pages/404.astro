---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/site';

const description = '요청한 페이지를 찾을 수 없습니다.';
---

<SiteLayout title="페이지를 찾을 수 없음" description={description} notFound>
  <h1 class="page-title">페이지를 찾을 수 없습니다</h1>
  <p class="empty">주소가 바뀌었거나 페이지가 삭제되었을 수 있습니다.</p>
  <a class="back-link" href={sitePath()}>← 첫 화면으로</a>
</SiteLayout>
