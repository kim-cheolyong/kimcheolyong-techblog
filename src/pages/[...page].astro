---
import type { GetStaticPaths, Page } from 'astro';
import PostList from '../components/PostList.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { publishedPosts, type Post } from '../lib/posts';
import { siteDescription, siteName } from '../lib/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await publishedPosts();
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };
const firstPage = page.currentPage === 1;
const pageTitle = `글 목록 ${page.currentPage}페이지`;
---

<SiteLayout title={firstPage ? undefined : pageTitle} description={firstPage ? siteDescription : `${siteName}의 ${pageTitle}입니다.`} section="posts">
  {firstPage ? (
    <div class="intro">
      <h1>{siteName}</h1>
      <p>{siteDescription}</p>
    </div>
  ) : <h1 class="page-title">{pageTitle}</h1>}

  <section aria-labelledby={firstPage ? 'latest-posts' : undefined}>
    {firstPage && <h2 id="latest-posts" class="section-heading">최신 글</h2>}
    {page.data.length > 0 ? <PostList posts={page.data} heading={firstPage ? 'h3' : 'h2'} /> : <p class="empty">아직 공개된 글이 없습니다.</p>}
  </section>

  {page.lastPage > 1 && (
    <nav class="pagination" aria-label="글 목록 페이지">
      {page.url.prev && <a rel="prev" href={page.url.prev}>← 이전 페이지</a>}
      <span>{page.currentPage} / {page.lastPage}</span>
      {page.url.next && <a rel="next" href={page.url.next}>다음 페이지 →</a>}
    </nav>
  )}
</SiteLayout>
